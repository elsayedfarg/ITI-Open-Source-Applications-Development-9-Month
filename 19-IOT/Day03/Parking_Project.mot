    this[name] = value;
  }</addProperty></Parameter><Parameter name='OnSearch' ><Name type='singleValue' >OnSearch</Name><Type type='singleValue' >event</Type><Value type='singleValue' >//you can access SearchValue,SelectedColumn variables 
 //SelectedColumn : parameter stores column Name 
 //SearchValue : parameter stores column Value  
 //return the values to Search Method 
 return {&apos;SearchValue&apos; : SearchValue,&apos;SelectedColumn&apos;:SelectedColumn}</Value><DisplayName type='singleValue' >OnSearch</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='OnButtonClick' ><Name type='singleValue' >OnButtonClick</Name><Type type='singleValue' >event</Type><Value type='singleValue' >//you can access ClickedButton variable 
 //ClickedButton : Parameter that hold clicked button name 
  </Value><DisplayName type='singleValue' >OnButtonClick</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='ButtonsActionBehaviour' ><Name type='singleValue' >ButtonsActionBehaviour</Name><Type type='singleValue' >True/False</Type><Value type='singleValue' >1</Value><DisplayName type='singleValue' >Buttons Action Behavior</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='ExpandDirection' ><Name type='singleValue' >ExpandDirection</Name><Type type='singleValue' >Select</Type><Value type='array' ><element>horizontal</element><element>vertical</element></Value><DisplayName type='singleValue' >Expand Direction</DisplayName><exist type='singleValue' >true</exist><SelectedValue type='singleValue' >horizontal</SelectedValue><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='SearchDivWidth' ><Name type='singleValue' >SearchDivWidth</Name><Type type='singleValue' >hidden</Type><Value type='singleValue' >SearchDivExpandedBefore</Value><DisplayName type='singleValue' >Search Div Width</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='DefaultNotificationMassages' ><Name type='singleValue' >DefaultNotificationMassages</Name><Type type='singleValue' >True/False</Type><Value type='singleValue' >1</Value><DisplayName type='singleValue' >Default Notification Massages</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
    this[name] = value;
  }</addProperty></Parameter><Parameter name='OnNotification' ><Name type='singleValue' >OnNotification</Name><Type type='singleValue' >event</Type><Value type='singleValue' >//Called when any operation completes and built-in toastr is disabled
//Variables available you can use inside your massages:
//NotificationType: &apos;success&apos; or &apos;error&apos;
//OperationType: &apos;refresh&apos;, &apos;delete&apos;, &apos;update&apos;, &apos;add&apos;, &apos;search&apos;, &apos;navigation&apos;
//RecordId: Current record ID from database
//AppId: Application ID
//CurrentRecordIndex: Current record position (0-based)
//TotalRecords: Total number of records
//PluginName: DataNavigator plugin name
//ApplicationName: Application name (without &apos;DataNavigator&apos;)

// COMPLETE EXAMPLE: Control each operation type with custom messages using context data

switch(OperationType) {
    case &apos;delete&apos;:
        NotificationType === &apos;success&apos; ? 
            toastr.success(&apos;🗑️ Record &apos; + RecordId + &apos; deleted from &apos; + ApplicationName + &apos;!&apos;) : 
            toastr.error(&apos;❌ Failed to delete record &apos; + RecordId);
        break;
        
    case &apos;update&apos;:
        NotificationType === &apos;success&apos; ? 
            toastr.success(&apos;✏️ Record &apos; + RecordId + &apos; updated in app &apos; + AppId + &apos;!&apos;) : 
            toastr.error(&apos;⚠️ Failed to update record &apos; + RecordId);
        break;
        
    case &apos;add&apos;:
        NotificationType === &apos;success&apos; ? 
            toastr.success(&apos;🎉 New record added! Total: &apos; + TotalRecords) : 
            toastr.error(&apos;❌ Failed to add new record&apos;);
        break;
        
    case &apos;refresh&apos;:
        NotificationType === &apos;success&apos; ? 
            toastr.success(&apos;🔄 &apos; + ApplicationName + &apos; refreshed! &apos; + TotalRecords + &apos; records loaded&apos;) : 
            toastr.error(&apos;🔄 Failed to refresh &apos; + ApplicationName);
        break;
        
    case &apos;search&apos;:
        toastr.warning(&apos;🔍 Search issue in &apos; + ApplicationName);
        break;
        
    case &apos;navigation&apos;:
        toastr.info(&apos;📍 Position: &apos; + (CurrentRecordIndex + 1) + &apos; of &apos; + TotalRecords);
        break;
        
    default:
        NotificationType === &apos;success&apos; ? 
