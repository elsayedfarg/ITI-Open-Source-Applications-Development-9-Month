break;
}
case 'feetxt':{
 
break;
}
case 'feeArlbl':{
 
break;
}
case 'sayed_Smart_Parking_Information_Reload':{
window.location.reload(); 
break;
}
case 'sayed_Smart_Parking_Information_Submit':{
var ParkingName_Value = GetPluginParameterValue(&apos;ParkingNametxt&apos;,&apos;text&apos;);
var Latitude_Value = GetPluginParameterValue(&apos;Latitudetxt&apos;,&apos;text&apos;);
var Longitude_Value = GetPluginParameterValue(&apos;Longitudetxt&apos;,&apos;text&apos;);
var Ownarname_Value = GetPluginParameterValue(&apos;Ownarnametxt&apos;,&apos;text&apos;);
var ContractEmail_Value = GetPluginParameterValue(&apos;ContractEmailtxt&apos;,&apos;text&apos;);
var SlotsCount_Value = GetPluginParameterValue(&apos;SlotsCounttxt&apos;,&apos;text&apos;);
var fee_Value = GetPluginParameterValue(&apos;feetxt&apos;,&apos;text&apos;);

var sayed_Smart_Parking_Information_ObjectData = {&apos;AppName&apos;: &apos;sayed_Smart_Parking_Information&apos;, &apos;Readings&apos;: {&apos;ParkingName&apos;: ParkingName_Value,&apos;Latitude&apos;: Latitude_Value,&apos;Longitude&apos;: Longitude_Value,&apos;Ownarname&apos;: Ownarname_Value,&apos;ContractEmail&apos;: ContractEmail_Value,&apos;SlotsCount&apos;: SlotsCount_Value,&apos;fee&apos;: fee_Value}};

var DataNavigatorObject=GetPluginParameterValue(&apos;sayed_Smart_Parking_InformationDataNavigator&apos;,&apos;Plugin Object&apos;);
 // access Add function from Data Navigator Plugin Object to add Appliction Data
 DataNavigatorObject.Add(sayed_Smart_Parking_Information_ObjectData,sayed_Smart_Parking_Information_AfterPostCallBack);function sayed_Smart_Parking_Information_AfterPostCallBack(){ } 
break;
}
case 'sayed_Smart_Parking_Information_Update':{
// &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;  Automatically Generated Code  &gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt; 
 	 // this array includes records objects 
 var ReadingsObjArr = []; 
 var ReadingsObj = {};  
 var CurrentRecord=GetPluginParameterValue(&apos;sayed_Smart_Parking_InformationDataNavigator&apos;,&apos;CurrentRecordIndexDB&apos;) 
 	 // create object to every field in record 
 	 //create object to ParkingName field
var VParkingNameObj = {} 
var ParkingNametxt = GetPluginParameterValue(&apos;ParkingNametxt&apos;, &apos;Text&apos;);
VParkingNameObj[&apos;ColName&apos;]=&apos;ParkingName&apos; 
VParkingNameObj[&apos;Value&apos;]=ParkingNametxt
VParkingNameObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VParkingNameObj)
 ReadingsObjArr.push(VParkingNameObj) 
 
	 //create object to Latitude field
var VLatitudeObj = {} 
var Latitudetxt = GetPluginParameterValue(&apos;Latitudetxt&apos;, &apos;Text&apos;);
VLatitudeObj[&apos;ColName&apos;]=&apos;Latitude&apos; 
VLatitudeObj[&apos;Value&apos;]=Latitudetxt
VLatitudeObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VLatitudeObj)
 ReadingsObjArr.push(VLatitudeObj) 
 
	 //create object to Longitude field
var VLongitudeObj = {} 
var Longitudetxt = GetPluginParameterValue(&apos;Longitudetxt&apos;, &apos;Text&apos;);
VLongitudeObj[&apos;ColName&apos;]=&apos;Longitude&apos; 
VLongitudeObj[&apos;Value&apos;]=Longitudetxt
VLongitudeObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VLongitudeObj)
 ReadingsObjArr.push(VLongitudeObj) 
 
	 //create object to Ownarname field
var VOwnarnameObj = {} 
var Ownarnametxt = GetPluginParameterValue(&apos;Ownarnametxt&apos;, &apos;Text&apos;);
VOwnarnameObj[&apos;ColName&apos;]=&apos;Ownarname&apos; 
VOwnarnameObj[&apos;Value&apos;]=Ownarnametxt
VOwnarnameObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VOwnarnameObj)
 ReadingsObjArr.push(VOwnarnameObj) 
 
	 //create object to ContractEmail field
var VContractEmailObj = {} 
var ContractEmailtxt = GetPluginParameterValue(&apos;ContractEmailtxt&apos;, &apos;Text&apos;);
VContractEmailObj[&apos;ColName&apos;]=&apos;ContractEmail&apos; 
VContractEmailObj[&apos;Value&apos;]=ContractEmailtxt
VContractEmailObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VContractEmailObj)
 ReadingsObjArr.push(VContractEmailObj) 
 
	 //create object to SlotsCount field
var VSlotsCountObj = {} 
var SlotsCounttxt = GetPluginParameterValue(&apos;SlotsCounttxt&apos;, &apos;Text&apos;);
VSlotsCountObj[&apos;ColName&apos;]=&apos;SlotsCount&apos; 
VSlotsCountObj[&apos;Value&apos;]=SlotsCounttxt
VSlotsCountObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VSlotsCountObj)
 ReadingsObjArr.push(VSlotsCountObj) 
 
	 //create object to fee field
var VfeeObj = {} 
var feetxt = GetPluginParameterValue(&apos;feetxt&apos;, &apos;Text&apos;);
VfeeObj[&apos;ColName&apos;]=&apos;fee&apos; 
VfeeObj[&apos;Value&apos;]=feetxt
VfeeObj[&apos;Type&apos;]=&apos;txt&apos;
 RTEConsoleLog(&apos;ReadingsObj&apos;,VfeeObj)
 ReadingsObjArr.push(VfeeObj) 
 
 	 // get Data Navigator plugin object to access its functions 
  var DataNavigatorObject=GetPluginParameterValue(&apos;sayed_Smart_Parking_InformationDataNavigator&apos;,&apos;Plugin Object&apos;);
 	 var OptionalParamterOFReload ; //true or false value to allow or prevent Reload Page After Update 
	 // access Update function from Data Navigator Plugin Object to Update Application Data
 DataNavigatorObject.Update(CurrentRecord,ReadingsObjArr,OptionalParamterOFReload); 
 
 // &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;  End Of Automatically Generated Code  &gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt; 
break;
}
case 'sayed_Smart_Parking_Information_Delete':{
// &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;  Automatically Generated Code  &gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt; 
// Get Current Record Id In DB  
 var CurrentRecordInDB=GetPluginParameterValue(&apos;sayed_Smart_Parking_InformationDataNavigator&apos;,&apos;Current Record Index DB&apos;) 
// get Data Navigator plugin object to access its functions 
  var DataNavigatorObject=GetPluginParameterValue(&apos;sayed_Smart_Parking_InformationDataNavigator&apos;,&apos;Plugin Object&apos;);
// access Delete function from Data Navigator Plugin Object to delete Appliction Data
 DataNavigatorObject.Delete(CurrentRecordInDB, (err,returnedStatus) =&gt; {});
 // &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;  End Of Automatically Generated Code  &gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt; 
