function RedrawRTEBGPlugins(){
if(window.RTEBackGroundPlugins != undefined){
if(window.RTEBackGroundPlugins.length&gt;0){
            for(var j=0; j &lt; window.RTEBackGroundPlugins.length; j++){
            var PluginIndex=window.RTEBackGroundPlugins[j].PluginIndex;
            var PluginDiv=window.RTEBackGroundPlugins[j].PluginDiv;
            var PluginDivId=window.RTEBackGroundPlugins[j].PluginDivId;
            IDEObject.CurrentProject.ProjectPagesList[0].UsedPluginsList[PluginIndex].Draw(PluginDiv,PluginDivId);
            }
}}};</script></page><page id='4' name='Parking template'><PageHeight>100%</PageHeight><PageWidth>100%</PageWidth><PageBackgroundColor>undefined</PageBackgroundColor><PageCssCode></PageCssCode><PageParameters><Parameter name='PageId'><Type>label</Type><Value>4</Value><Name>PageId</Name><DisplayName>Page Id</DisplayName></Parameter><Parameter name='PageName'><Type>input</Type><Value>Parking template</Value><Name>PageName</Name><DisplayName>Page Name</DisplayName></Parameter><Parameter name='PageType'><Type>Select</Type><Value>Standard,Mobile,Template</Value><SelectedValue>Template</SelectedValue><Name>PageType</Name><DisplayName>Page Type</DisplayName></Parameter><Parameter name='TemplateView'><Type>hidden</Type><Value>WebView</Value><Name>TemplateView</Name><DisplayName>Template View</DisplayName></Parameter><Parameter name='PageTemplateId'><Type>hidden</Type><Value></Value><Name>PageTemplateId</Name><DisplayName>Template Name</DisplayName></Parameter><Parameter name='TemplatePages'><Type>hidden</Type><Value></Value><SelectedValue></SelectedValue><Name>TemplatePages</Name><DisplayName>Template Name</DisplayName></Parameter><Parameter name='MultiTemplatePages'><Type>MultiSelection</Type><Value>{&quot;Parking template&quot;:false}</Value><SelectedValue></SelectedValue><Name>MultiTemplatePages</Name><DisplayName>Templates Name</DisplayName></Parameter><Parameter name='PageMenuId'><Type>hidden</Type><Value></Value><Name>PageMenuId</Name><DisplayName>Page menu name</DisplayName></Parameter><Parameter name='PreventLoadingIcon'><Type>True/False</Type><Value>0</Value><Name>PreventLoadingIcon</Name><DisplayName>Prevent Loading Icon</DisplayName></Parameter><Parameter name='RequireSensorList'><Type>True/False</Type><Value>0</Value><DisplayName>Get sensors list in RTE</DisplayName><Name>RequireSensorList</Name></Parameter><Parameter name='RequireAppList'><Type>True/False</Type><Value>0</Value><DisplayName>Get applications list in RTE</DisplayName><Name>RequireAppList</Name></Pa