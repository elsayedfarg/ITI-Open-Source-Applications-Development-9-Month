          var DataNavigatorObject = GetPluginParameterValue(&quot;sayed_Smart_Parking_InformationDataNavigator&quot;, &quot;Plugin Object&quot;);
          var RecordObject = DataNavigatorObject.GetCurrentRecordObj();
          if(RecordObject) {
 SetPluginParameterValue(&apos;ParkingNametxt&apos;, &apos;Text&apos;, RecordObject[&apos;ParkingName&apos;]); 
 DrawPlugin(&apos;ParkingNametxt&apos;);
 SetPluginParameterValue(&apos;Latitudetxt&apos;, &apos;Text&apos;, RecordObject[&apos;Latitude&apos;]); 
 DrawPlugin(&apos;Latitudetxt&apos;);
 SetPluginParameterValue(&apos;Longitudetxt&apos;, &apos;Text&apos;, RecordObject[&apos;Longitude&apos;]); 
 DrawPlugin(&apos;Longitudetxt&apos;);
 SetPluginParameterValue(&apos;Ownarnametxt&apos;, &apos;Text&apos;, RecordObject[&apos;Ownarname&apos;]); 
 DrawPlugin(&apos;Ownarnametxt&apos;);
 SetPluginParameterValue(&apos;ContractEmailtxt&apos;, &apos;Text&apos;, RecordObject[&apos;ContractEmail&apos;]); 
 DrawPlugin(&apos;ContractEmailtxt&apos;);
 SetPluginParameterValue(&apos;SlotsCounttxt&apos;, &apos;Text&apos;, RecordObject[&apos;SlotsCount&apos;]); 
 DrawPlugin(&apos;SlotsCounttxt&apos;);
 SetPluginParameterValue(&apos;feetxt&apos;, &apos;Text&apos;, RecordObject[&apos;fee&apos;]); 
 DrawPlugin(&apos;feetxt&apos;);
 }
