        DataNavigatorObject.Delete(RecordID)
// &lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;  End Of Automatically Generated Code  &gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;</Value><DisplayName type='singleValue' >OnDelete</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
