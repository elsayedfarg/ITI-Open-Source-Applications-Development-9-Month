    this[name] = value;
  }</addProperty></Parameter><Parameter name='ontimerTick' ><Name type='singleValue' >ontimerTick</Name><Type type='singleValue' >event</Type><Value type='singleValue' >//************* Start Set Query Parameter Value  For Grid 1 ************ 

ExecuteQueryModified(&apos;SELECT * FROM GROUP_74207 WHERE id IN (SELECT MAX(id) FROM  GROUP_74207 GROUP BY SensorId)&apos;, Grid_1_callbackFunc, &apos;Grid 1&apos;);

function Grid_1_callbackFunc(error, xhr) {
  if (xhr.response) {
    Grid_1DataArr = JSON.parse(xhr.response);
    for (var i = 0; i &lt; Grid_1DataArr.length; i++) {
      var recordObj = Grid_1DataArr[i];
      var slotSensorId = recordObj.SensorId;
      var slotNearnessLevel = recordObj.currentNearnessLevel;

      if (slotNearnessLevel == 0) {
        SetPluginParameterValue(&quot;image_&quot; + slotSensorId, &apos;Visible&apos;, 1);
        SetPluginParameterValue(&quot;shape_&quot; + slotSensorId, &apos;Color&apos;, &apos;red&apos;);
      } else {
        SetPluginParameterValue(&quot;image_&quot; + slotSensorId, &apos;Visible&apos;, 0);
        SetPluginParameterValue(&quot;shape_&quot; + slotSensorId, &apos;Color&apos;, &apos;green&apos;);
      }
      DrawPlugin(&quot;image_&quot; + slotSensorId);
      DrawPlugin(&quot;shape_&quot; + slotSensorId);
    }

    DrawPlugin(&apos;Grid 1&apos;);
  } //End If 
} //End CB function 

