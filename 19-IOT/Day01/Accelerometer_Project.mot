    this[name] = value;
  }</addProperty></Parameter><Parameter name='onclick' ><Name type='singleValue' >onclick</Name><Type type='singleValue' >event</Type><Value type='singleValue' >var screenText = GetPluginParameterValue(&apos;screenTextToggleRadioBtn&apos;, &apos;Selected item&apos;);
var StartPoint_Text = GetPluginParameterValue(&apos;StartPoint&apos;, &apos;Text&apos;);
var FontSize_Text = GetPluginParameterValue(&apos;FontSize&apos;, &apos;Text&apos;);
var FontColor_Selected_value = GetPluginParameterValue(&apos;FontColor&apos;, &apos;Selected value&apos;);
var Text_Text = GetPluginParameterValue(&apos;TextBody&apos;, &apos;Text&apos;);
var message;
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;, &apos;Text&apos;);
var topic;
if (screenText == &quot;ON&quot;) {
  topic = phoneNumber + &quot;/ScreenText/ON&quot;;
  message = StartPoint_Text + &quot;,&quot; + FontSize_Text + &quot;,&quot; + FontColor_Selected_value + &quot;,&quot; + Text_Text;
} else {
  topic = phoneNumber+ &quot;/ScreenText/OFF&quot;;
  message = &quot;OFF&quot;;
}

console.log(&quot;topic&quot;, topic);

publish(topic, message);</Value><DisplayName type='singleValue' >OnClick Event</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
