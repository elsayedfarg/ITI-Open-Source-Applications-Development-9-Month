    this[name] = value;
  }</addProperty></Parameter></usedPlugin><script>function publish(topic, message){
  FireEvent({
    EventType: &quot;Mqtt Publish&quot;,
    EventProperties: {
        mqttUrl: &quot;learning.masterofthings.com&quot;,
        username: &quot;MoTSensorKitv2.0&quot;,
        password: &quot;MoTSensorKitv2.0Pass&quot;,
        topic: &apos;Phone/&apos; + topic,
        message: message
    }
  }, function(){
    alert(&quot;done&quot;);
  });
}
function Plugin_onclick(pluginName){
switch(pluginName){
case 'Page IoT Kit - Control':{
 
break;
}
case 'phoneNumber':{
 
break;
}
case 'phoneLabel':{
 
break;
}
