  res = JSON.parse(res);
  SetPluginParameterValue(&quot;AccelerometerLable&quot;, &quot;Caption&quot;, &quot;x=&quot; + res.x + &quot; y=&quot; + res.y + &quot; z=&quot; + res.z + &quot; captureTime=&quot; + res.captureTime);
  DrawPlugin(&quot;AccelerometerLable&quot;);
  MoveBall(res);

});


//============ MoveBall function to control the Ball ==============
// It checks, if capture time is greater than last capture time, then take the accelerometer value.
//

var MoveBall = function MoveBall(Accelerometer) {

  //console.log(&quot;captuerTime=&quot;+captureTime+&quot;, Accelerometer.captureTime=&quot;+Accelerometer.captureTime)  
  if (Accelerometer.captureTime &gt; captureTime) {
    captureTime = parseFloat(Accelerometer.captureTime);
    x = parseFloat(Accelerometer.x);
    y = parseFloat(Accelerometer.y);
    z = parseFloat(Accelerometer.z);


    //console.log(&quot;x=&quot;+x+&quot;, y=&quot;+y+&quot;, z=&quot;+z+&quot;, captuerTime=&quot;+captureTime)

    BallPositionLocationY = parseFloat(GetPluginParameterValue(&quot;Ball&quot;, &quot;Location of Y axis&quot;));
    BallPositionLocationX = parseFloat(GetPluginParameterValue(&quot;Ball&quot;, &quot;Location of X axis&quot;));


    //console.log (&quot;BallPositionLocationX=&quot;+BallPositionLocationX+&quot;, BallPositionLocationY=&quot;+BallPositionLocationY);

    BallPositionLocationY = BallPositionLocationY + (x * 2);
    BallPositionLocationX = BallPositionLocationX + (y * 2);

    if (BallPositionLocationY &gt; 527) BallPositionLocationY = 527;
    if (BallPositionLocationY &lt; 145) BallPositionLocationY = 145;
    if (BallPositionLocationX &lt; 50) BallPositionLocationX = 50;
    if (BallPositionLocationX &gt; 889) BallPositionLocationX = 889;
    if (BallPositionLocationX &gt; 880 &amp;&amp; BallPositionLocationY &lt; 148) {
      ShowPlugin(&quot;WeelDone&quot;);
    } else {
      HidePlugin(&quot;WeelDone&quot;);
    }

    SetPluginParameterValue(&quot;BallPosition Lable&quot;, &quot;Caption&quot;, &quot;Ball x=&quot; + BallPositionLocationX + &quot;, Ball y=&quot; + BallPositionLocationY);
    DrawPlugin(&quot;BallPosition Lable&quot;);

    SetPluginParameterValue(&quot;Ball&quot;, &quot;Location of X axis&quot;, BallPositionLocationX);
    SetPluginParameterValue(&quot;Ball&quot;, &quot;Location of Y axis&quot;, BallPositionLocationY);
    DrawPlugin(&quot;Ball&quot;);
  }
}</Value><DisplayName type='singleValue' >Timer Tick</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
