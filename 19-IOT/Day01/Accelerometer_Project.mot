var imageUrl_Text = GetPluginParameterValue(&apos;imageUrl&apos;, &apos;Text&apos;);
var ScreenImageDuration_Text = GetPluginParameterValue(&apos;ScreenImageDuration&apos;, &apos;Text&apos;);
var ScreenImageDuration_Text = GetPluginParameterValue(&apos;ScreenImageDuration&apos;, &apos;Text&apos;);
var message = imagePostion_Text + &quot;,&quot; + ScreenImageDuration_Text + &quot;,&quot; + imageUrl_Text;
