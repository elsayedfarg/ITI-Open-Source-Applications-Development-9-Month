    this[name] = value;
  }</addProperty></Parameter><Parameter name='onclick' ><Name type='singleValue' >onclick</Name><Type type='singleValue' >event</Type><Value type='singleValue' >var imagePostion_Text = GetPluginParameterValue(&apos;imagePostion&apos;, &apos;Text&apos;);
var imageUrl_Text = GetPluginParameterValue(&apos;imageUrl&apos;, &apos;Text&apos;);
var ScreenImage = GetPluginParameterValue(&apos;screenImageToggleRadioBtn&apos;, &apos;Selected item&apos;);


var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;, &apos;Text&apos;);
var topic = &quot;&quot;;
var message;
if (ScreenImage == &quot;ON&quot;) {
  topic = phoneNumber + &quot;/ScreenImage/ON&quot;;
  message = imagePostion_Text + &quot;,&quot; + imageUrl_Text;
} else {
  topic = phoneNumber + &quot;/ScreenImage/OFF&quot;;
  message = &quot;OFF&quot;
}

console.log(&quot;topic&quot;, topic);

publish(topic, message);</Value><DisplayName type='singleValue' >OnClick Event</DisplayName><exist type='singleValue' >true</exist><addProperty type='singleValue' >function (name, value) {
