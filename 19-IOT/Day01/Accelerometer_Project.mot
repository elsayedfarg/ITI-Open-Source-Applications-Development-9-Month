var mousePosFunction=function(mousePos)
{
var xPos=mousePos.x;
var yPos=mousePos.y;
//console.log(&quot;after function xPos=&quot;+xPos+&quot;, yPos&quot;+yPos);

SetPluginParameterValue(&quot;MousePos&quot;,&quot;LabelValue&quot;,&quot;Mouse X position:&quot;+xPos+&quot; Mouse Y position:&quot;+yPos);
DrawPlugin(&quot;MousePos&quot;);

};
GetMouseXYPos(mousePosFunction); /// set mousePosFunction as the call back function for the GetMouseXYPos RTE extended funciton  

