case 'screenBrightnessFrequency':{
 
break;
}
case 'screenBrightnessFrequecnyHint':{
 
break;
}
case 'vibrateLabel':{
 
break;
}
case 'vibrateToggleRadioBtn':{
 
break;
}
case 'vibrateDuration':{
 
break;
}
case 'vibrateDurationLabel':{
 
break;
}
case 'vibrateFrequencyLabel':{
 
break;
}
case 'vibrateFrequency':{
 
break;
}
case 'vibrateFrequencyHint':{
 
break;
}
case 'LineSeparator 4':{
 
break;
}
case 'soundToneLabel':{
 
break;
}
case 'soundToneDurationLabel':{
 
break;
}
case 'soundToneDuration':{
 
break;
}
case 'Label Plugin 20':{
 
break;
}
case 'soundToneFrequencyLabel':{
 
break;
}
case 'soundToneFrequency':{
 
break;
}
case 'Label Plugin 22':{
 
break;
}
case 'ComboBoxPlugin 1':{
 
break;
}
case 'LineSeparator 5':{
 
break;
}
case 'flashPublish':{
var flash = GetPluginParameterValue(&apos;flashRadioBtn&apos;,&apos;Selected item&apos;);
var phoneNumber_Text = GetPluginParameterValue(&apos;phoneNumber&apos;,&apos;Text&apos;);

if(flash == &quot;ON&quot;){
  var topic = phoneNumber_Text + &quot;/Flash/ON&quot;;  
}else{
  var topic = phoneNumber_Text + &quot;/Flash/OFF&quot;;
}

console.log(&quot;topic&quot;, topic);

publish(topic, flash); 
break;
}
case 'flashDurationPublish':{
var message = GetPluginParameterValue(&apos;flashDuration&apos;,&apos;Text&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;,&apos;Text&apos;);
var topic = phoneNumber + &quot;/Flash/Duration&quot;;

publish(topic, message); 
break;
}
case 'flashFrequencyPublish':{
var message = GetPluginParameterValue(&apos;flashFrequency&apos;,&apos;Text&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;,&apos;Text&apos;);
var topic = phoneNumber + &quot;/Flash/Frequency&quot;;

publish(topic, message); 
break;
}
case 'screenPublish':{
var screenBrightness = GetPluginParameterValue(&apos;screenBrightness&apos;, &apos;Text&apos;);
var ScreenBrightness_SelectedItem = GetPluginParameterValue(&apos;screenBrightnessRadioBtn&apos;, &apos;Selected item&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;, &apos;Text&apos;);

if (ScreenBrightness_SelectedItem == &quot;ON&quot;) {
  var topic = phoneNumber + &quot;/ScreenBrightness/ON&quot;;
  message = screenBrightness;
} else {
  var topic = phoneNumber + &quot;/ScreenBrightness/OFF&quot;;
  message = &quot;OFF&quot;;
}

publish(topic, message); 
break;
}
case 'screenDurationPublish':{
var screenBrightnessDuration = GetPluginParameterValue(&apos;screenBrightnessDuration&apos;, &apos;Text&apos;);
var screenBrightness = GetPluginParameterValue(&apos;screenBrightness&apos;,&apos;Text&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;, &apos;Text&apos;);
var topic = phoneNumber + &quot;/ScreenBrightness/Duration&quot;;

var message = screenBrightness+&quot;,&quot;+screenBrightnessDuration;

  
publish(topic, message); 
break;
}
case 'screenFrequencyPublish':{
var message = GetPluginParameterValue(&apos;screenBrightnessFrequency&apos;,&apos;Text&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;,&apos;Text&apos;);
var topic = phoneNumber + &quot;/ScreenBrightness/Frequency&quot;;

publish(topic, message); 
break;
}
case 'vibratePublish':{
var message = GetPluginParameterValue(&apos;vibrateToggleRadioBtn&apos;,&apos;Selected item&apos;);
var phoneNumber = GetPluginParameterValue(&apos;phoneNumber&apos;,&apos;Text&apos;);

if(message == &quot;ON&quot;){
  var topic = phoneNumber + &quot;/Vibrate/ON&quot;;  
}else{
  var topic = phoneNumber + &quot;/Vibrate/OFF&quot;;
}

console.log(&quot;topic&quot;, topic);

publish(topic, message); 
break;
